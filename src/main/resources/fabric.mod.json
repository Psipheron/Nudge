{
  "schemaVersion": 1,
  "id": "nudge",
  "version": "${version}",
  "name": "Nudge",
  "description": "Subtle logarithmic aim assist for Fabric.",
  "authors": [
    "Psipheron"
  ],
  "license": "LGPL-3.0-only",
  "icon": "assets/modid/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.psipheron.nudge.NudgeClient"
    ],
    "modmenu": [
      "com.psipheron.nudge.ModMenuIntegration"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": "*"
